DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth2
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# Formspree
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxxxxxx

# Site + production
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for local SQLite. Production may use a PostgreSQL connection URL.
DATABASE_URL=
DB_CONN_MAX_AGE=60
# Behind nginx: HTTP_X_REAL_IP (with `proxy_set_header X-Real-IP $remote_addr;`)
CLIENT_IP_HEADER=
# locmem (dev) | redis (set REDIS_URL) | db (run `python manage.py createcachetable`)
CACHE_BACKEND=locmem
# Production example: redis://127.0.0.1:6379/1
REDIS_URL=
# SMTP — required in production for password-reset links and verification codes
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10
TRUST_X_FORWARDED_PROTO=False

# Production: hashed static file names for long-lived caching (run collectstatic on deploy)
STATIC_HASHED_FILENAMES=False

# Live notification stream (SSE). Set False on PythonAnywhere — the bell polls instead.
NOTIFICATIONS_SSE=
